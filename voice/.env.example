# Copy to .env on the voice host (never commit .env).
# Public NVIDIA endpoints runtime (cloud catalog). Get a key at https://build.nvidia.com and fill it in yourself.
NVIDIA_API_KEY=
# Clinic Worker (same VOICE_TOOL_SECRET must be set as a Worker secret: npx wrangler secret put VOICE_TOOL_SECRET)
SUYAT_API_BASE=https://YOUR-WORKER.workers.dev
VOICE_TOOL_SECRET=
